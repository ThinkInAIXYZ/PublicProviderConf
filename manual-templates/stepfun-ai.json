{
  "id": "stepfun-ai",
  "api": "https://api.stepfun.ai/v1",
  "name": "StepFun (Global)",
  "doc": "https://platform.stepfun.ai/docs/en/overview/concept",
  "display_name": "StepFun (Global)",
  "models": [
    {
      "id": "step-5-preview",
      "name": "Step 5 Preview",
      "description": "StepFun frontier model for large-scale agent applications, coding, and knowledge work",
      "attachment": true,
      "reasoning": {
        "supported": true,
        "default": true
      },
      "reasoning_options": [
        {
          "type": "effort",
          "values": [
            "low",
            "medium",
            "high"
          ]
        }
      ],
      "tool_call": true,
      "interleaved": {
        "field": "reasoning_content"
      },
      "structured_output": true,
      "temperature": true,
      "last_updated": "2026-09-20",
      "modalities": {
        "input": [
          "text",
          "image",
          "video"
        ],
        "output": [
          "text"
        ]
      },
      "limit": {
        "context": 1000000,
        "input": 1000000,
        "output": 384000
      },
      "cost": {
        "input": 1,
        "output": 2.7,
        "cache_read": 0.05
      },
      "display_name": "Step 5 Preview",
      "type": "chat",
      "vision": true,
      "metadata": {
        "source": "public-provider-conf-template",
        "lifecycle": "preview",
        "notes": [
          "Official maximum input and output are both 1M tokens and max_tokens defaults to INF; 384000 is recorded as a conservative default output ceiling.",
          "Output tokens include both the reasoning process and the final answer; cache-miss input billing includes writing new content to the cache."
        ]
      },
      "extra_capabilities": {
        "reasoning": {
          "supported": true,
          "interleaved": true,
          "summaries": true,
          "visibility": "summary",
          "continuation": [
            "thinking_blocks"
          ],
          "mode": "effort",
          "effort": "medium",
          "effort_options": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  ]
}
